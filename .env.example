# -----------------------------------------------------------------------------
# ftx-front - environment variables (Vite embeds them at build time)
#
# USAGE: copy .env.example .env   (Windows)   |   cp .env.example .env   (macOS/Linux)
# -----------------------------------------------------------------------------

# API Gateway URL, WITHOUT the /api/v1 suffix (10-devops/environments.md).
# local/develop: http://localhost:8080 | qa: http://localhost:8180 | prod: http://localhost:8280
# Empty = same origin as the frontend (useful if nginx proxies to the gateway).
VITE_API_BASE_URL=http://localhost:8080

# true  = backend simulated inside the browser (no gateway or microservices needed).
# false = calls the real API Gateway at VITE_API_BASE_URL.
VITE_API_MOCK=true

# Maximum wait per request, in milliseconds. After it the UI stops waiting and shows a
# retry message. Default: 10000.
VITE_API_TIMEOUT_MS=10000

# --- Simulated mode only (VITE_API_MOCK=true). Leave them out of qa/prod builds. ---
# Test administrator of the simulated backend. It works only inside the browser, against the
# simulated data; it is not a credential of any real system.
VITE_MOCK_ADMIN_EMAIL=admin@futbolix.test
VITE_MOCK_ADMIN_PASSWORD=Futbolix2026!
# Injected faults, comma separated. Empty = none (the default). Values: wompi-down
# They can also be switched on and off from the yellow banner of the simulated mode.
VITE_MOCK_FAULTS=
