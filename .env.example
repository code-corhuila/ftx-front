# ─────────────────────────────────────────────────────────────────────────────
# ftx-front — variables de entorno (Vite las incrusta en el build)
#
# USO: copy .env.example .env   (Windows)   ·   cp .env.example .env   (macOS/Linux)
# ─────────────────────────────────────────────────────────────────────────────

# URL del API Gateway, SIN el sufijo /api/v1 (10-devops/environments.md).
# local/develop: http://localhost:8080 · qa: http://localhost:8180 · prod: http://localhost:8280
# Vacío = mismo origen que el frontend (útil si nginx hace de proxy hacia el gateway).
VITE_API_BASE_URL=http://localhost:8080

# true  = backend simulado dentro del navegador (no necesita gateway ni microservicios).
# false = llama al API Gateway real en VITE_API_BASE_URL.
VITE_API_MOCK=true
